# Public, canonical deployment URL. No trailing slash. Set to your actual domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only email credentials. Use a sender verified in Resend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Generate with: openssl rand -hex 32
# Required in production; development uses a local-only fallback.
CONTACT_SECURITY_SECRET=

# Required in production for durable, atomic spam protection across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Separate siona-passport project only. Never use service-role keys here.
NEXT_PUBLIC_PASSPORT_SUPABASE_URL=
NEXT_PUBLIC_PASSPORT_SUPABASE_PUBLISHABLE_KEY=
